{
  "name": "kenwerk-web",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e && prettier --check src e2e",
    "format": "prettier --write src e2e",
    "test": "vitest run",
    "strings": "node scripts/check-ui-strings.mjs",
    "design": "node scripts/check-design.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.9.0",
    "@tanstack/react-query": "^5.108.4",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-bubble-menu": "3.35.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-collaboration": "3.35.0",
    "@tiptap/extension-collaboration-caret": "3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "@tiptap/y-tiptap": "3.3.1",
    "i18next": "^27.0.0",
    "lowlight": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.15.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.9"
